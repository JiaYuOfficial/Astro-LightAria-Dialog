---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../config/site';

// 个人主页（简历）：大头像 + 基本信息（site.ts profile 配置） + 介绍文案（about.md）
const abouts = await getCollection('about');
const page = abouts[0] || null;
const { Content } = page ? await render(page) : { Content: null };
const p = site.profile;
---

<BaseLayout title={`关于 · ${site.brand}`}>
  <main class="about-wrap">
    <div class="about-card">
      <div class="about-grid">
        <!-- 左侧：大头像矩形 -->
        <div class="about-photo">
          {p.avatar ? (
            <img src={p.avatar} alt={p.name} loading="eager" decoding="async" />
          ) : (
            <div class="about-photo__ph">{p.name.slice(0, 1)}</div>
          )}
        </div>
        <!-- 右侧：基本信息矩形 -->
        <div class="about-info">
          <h1 class="about-name">{p.name}</h1>
          {p.title && <p class="about-title">{p.title}</p>}
          {p.basics.length > 0 && (
            <dl class="about-basics">
              {p.basics.map((b) => (
                <div class="about-basic">
                  <dt>{b.label}</dt>
                  <dd>{b.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
      <!-- 底部：介绍文案矩形（由 md 文档定义） -->
      {Content && (
        <div class="about-desc">
          <h2 class="about-desc__title">关于我</h2>
          <div class="md about-md">
            <Content />
          </div>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
