---
import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorPage from '../components/ErrorPage.astro';
import { site } from '../config/site';
---

<BaseLayout title={`500 · 服务器错误`}>
  <main class="nf-wrap">
    <div class="nf-card">
      <ErrorPage
        code="500"
        title="服务器开小差了"
        desc="内部出了点问题，请稍后刷新重试。"
      />
    </div>
  </main>
</BaseLayout>
