---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { getCategory } from "../lib/work";

interface Props {
  title?: string;
  // —— SEO 扩展 ——
  description?: string; // 覆盖默认描述（文章页传摘要）
  image?: string; // og:image 封面/logo（相对路径自动转绝对）
  type?: string; // og:type：website | article | profile
  jsonLd?: object[]; // 页面附加 JSON-LD 结构化数据（文章/图集/视频）
  noindex?: boolean; // 强制本页 noindex（加密文章用；正式站关闭全站 noindex 后仍生效）
}
const {
  title = site.title,
  description = site.description,
  image = "",
  type = "website",
  jsonLd = [],
  noindex = false,
} = Astro.props;
// 绝对 URL 基础（canonical/og:image 用）：部署域名来自 astro.config 的 site
const baseUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "";
const canonicalUrl = baseUrl + Astro.url.pathname;
const absUrl = (u: string) => (u.startsWith("http") ? u : baseUrl + u);
const ogImage = absUrl(image || site.logo || "");
// 首页时不显示底栏「返回主页」
const isHome =
  Astro.url.pathname === "/" || Astro.url.pathname.endsWith("/index.html");

// 分类列表：由文章内容自动生成（首页顶栏用）
const works = await getCollection("works");
const tags = ["全部", ...new Set(works.map((w) => getCategory(w)))];

// 由主强调色派生色系变体（hex → rgba）
function hexToRgba(hex: string, alpha: number) {
  const h = hex.replace("#", "");
  const r = parseInt(h.slice(0, 2), 16);
  const g = parseInt(h.slice(2, 4), 16);
  const b = parseInt(h.slice(4, 6), 16);
  return `rgba(${r},${g},${b},${alpha})`;
}
const accent = site.theme.accent;
const accentSoft = hexToRgba(accent, 0.28);
const accentBorder = hexToRgba(accent, 0.55);

// 生成主题 CSS（注入全局 :root，避免 define:vars 作用域问题）
const themeCss = `
:root {
  --lg-accent: ${accentSoft};
  --lg-accent-border: ${accentBorder};
  --lg-accent-solid: ${accent};
  --bg-dim: ${site.bgDim ?? 0.55};
  ${site.background ? `--bg-img: url("${site.background}");` : ""}
}
`;
---

<!doctype html>
<html
  lang="zh-CN"
  style={`--nav-title-d:${site.navTitle?.desktop ?? 25}px;--nav-title-m:${site.navTitle?.mobile ?? 15}px`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0e1420" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={site.noindex || noindex ? "noindex,nofollow" : "index,follow"}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/avatar.svg" />
    <!-- Open Graph / 社交分享（微信/浏览器分享卡片依赖） -->
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <!-- 页面附加结构化数据（文章/图集/视频 JSON-LD）；转义 < 防止 </script> 逃逸注入 -->
    {
      jsonLd.map((o) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(o).replace(/</g, "\\u003c")}
        />
      ))
    }
    <!-- 站点色系：由 src/config/site.ts 的 theme.accent 派生 -->
    <style is:global set:html={themeCss}></style>

    <!-- 性能：预连接媒体域名（图床/视频 CDN），减少 TLS 握手延迟 -->
    {
      (site.preconnect || []).map((u) => (
        <>
          <link rel="preconnect" href={u} crossorigin />
          <link rel="dns-prefetch" href={u} />
        </>
      ))
    }
  </head>
  <body
    class={site.showBackground && site.background ? "has-bg" : ""}
    data-layout-desktop={site.layoutDesktop}
    data-layout-mobile={site.layoutMobile}
    data-default-style={site.style}
    data-default-bg={site.showBackground}
    data-default-blur={site.glassBlur}
    data-default-bgdim={site.bgDim ?? 0.55}
    data-default-font={site.mdFontSize}
    data-default-feed={site.feed.mode}
    data-default-accent={site.theme.accent}
  >
    {
      site.comments.enabled && (
        <script is:inline define:vars={{ commentsCfg: site.comments }}>
          window.__COMMENTS__ = commentsCfg;
        </script>
      )
    }
    {
      site.share?.enabled && (
        <script is:inline define:vars={{ shareCfg: site.share }}>
          window.__SHARE_CFG__ = shareCfg;
        </script>
      )
    }
    {
      (site.user?.name || site.user?.avatar) && (
        <script is:inline define:vars={{ userCfg: site.user }}>
          window.__USER__ = userCfg;
        </script>
      )
    }
    <!-- 顶部导航：品牌 + 操作按钮（分类 / 归档 / 搜索） -->
    <nav class="lg-nav">
      <a class="lg-nav__brand" href="/"
        >{site.brand}{site.subtitle && <small>{site.subtitle}</small>}</a
      >

      <div class="lg-nav__actions">
        {
          site.pages.moments && (
            <a
              class="lg-search-btn"
              href="/moments/"
              aria-label="动态"
              title="动态"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <circle cx="12" cy="12" r="9" />
                  <circle cx="12" cy="12" r="4.5" />
                </>
              </svg>
            </a>
          )
        }
        {
          site.pages.archive && (
            <a
              class="lg-search-btn"
              href="/archive/"
              aria-label="归档"
              title="归档"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
              </svg>
            </a>
          )
        }
        {
          site.pages.friends && (
            <a
              class="lg-search-btn"
              href="/friends/"
              aria-label="友情链接"
              title="友情链接"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
              </svg>
            </a>
          )
        }
        {
          site.pages.about && (
            <a
              class="lg-search-btn"
              href="/about/"
              aria-label="个人主页"
              title="个人主页"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </>
              </svg>
            </a>
          )
        }
        <button
          type="button"
          class="lg-search-btn"
          id="searchBtn"
          aria-label="搜索"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"
            ></path></svg
          >
        </button>
      </div>
    </nav>

    <div class="search-pop" id="searchPop" hidden>
      <input
        class="lg-input"
        id="search"
        type="search"
        aria-label="搜索案例"
        placeholder="搜索案例，如：婚礼 / 人像 / 活动"
      />
      <button
        type="button"
        class="search-pop__close"
        id="searchClose"
        aria-label="关闭搜索">×</button
      >
    </div>

    <slot />

    <div class="foot">
      <span>{site.footer.text || site.brand}</span>
      {
        site.footer.icp && (
          <a
            class="foot-icp"
            href="https://beian.miit.gov.cn/"
            target="_blank"
            rel="nofollow noopener noreferrer"
          >
            {site.footer.icp}
          </a>
        )
      }
      {
        site.footer.policeIcp && (
          <a
            class="foot-icp foot-icp--police"
            href={`https://beian.mps.gov.cn/#/query/webSearch?code=${(site.footer.policeIcp.match(/\d+/g) || []).join("")}`}
            target="_blank"
            rel="noreferrer"
          >
            {site.footer.policeIcon ? (
              <img
                class="foot-icp__icon"
                src={site.footer.policeIcon}
                alt=""
                loading="lazy"
                decoding="async"
              />
            ) : (
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2L4 5v6c0 5.25 3.4 9.74 8 11 4.6-1.26 8-5.75 8-11V5l-8-3zm-1.5 14.2l-3.6-3.6 1.4-1.4 2.2 2.2 4.6-4.6 1.4 1.4-6 6z" />
              </svg>
            )}
            {site.footer.policeIcp}
          </a>
        )
      }
    </div>

    <!-- 底部 TAB 栏（液态玻璃，常驻） -->
    <div class="tabbar">
      {
        !isHome && (
          <>
            <a class="tabbar-item" href="/" aria-label="返回主页">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M3 10.5L12 3l9 7.5" />
                  <path d="M5 9.5V21h14V9.5" />
                </>
              </svg>
              <span>返回主页</span>
            </a>
            <span class="tabbar-sep" />
            <button
              type="button"
              class="tabbar-item"
              id="backBtn"
              aria-label="返回上一页"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M9 14L4 9l5-5" />
                  <path d="M20 20v-7a4 4 0 0 0-4-4H8.5" />
                </>
              </svg>
              <span>返回上一页</span>
            </button>
            <span class="tabbar-sep" />
          </>
        )
      }
      {
        isHome && (
          <>
            <button
              type="button"
              class="tabbar-item"
              id="tagBtn"
              aria-label="分类筛选"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.83z" />
                  <circle cx="7" cy="7" r="1.5" />
                </>
              </svg>
              <span>分类</span>
            </button>
            <span class="tabbar-sep" />
            <button
              type="button"
              class="tabbar-item"
              id="typeBtn"
              aria-label="类型筛选"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z" />
              </svg>
              <span>筛选</span>
            </button>
            <span class="tabbar-sep" />
          </>
        )
      }
      <button
        type="button"
        class="tabbar-item"
        id="tocBtn"
        aria-label="文章目录"
        hidden
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10"></path></svg
        >
        <span>目录</span>
      </button>
      <span class="tabbar-sep" id="tocSep" hidden></span>
      <button
        type="button"
        class="tabbar-item"
        id="settingsBtn"
        aria-label="显示设置"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="3"></circle><path
            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
          ></path></svg
        >
        <span>设置</span>
      </button>
      <span class="tabbar-sep"></span>
      <button
        type="button"
        class="tabbar-item"
        id="shareBtn"
        aria-label="生成分享卡片"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><path
            d="M16 6l-4-4-4 4"></path><path d="M12 2v13"></path></svg
        >
        <span>分享</span>
      </button>
      <span class="tabbar-sep"></span>
      <button
        type="button"
        class="tabbar-item"
        id="toTop"
        aria-label="回到顶部"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M12 19V5"></path><path d="M5 12l7-7 7 7"></path></svg
        >
        <span>回到顶部</span>
      </button>
    </div>

    <!-- 标签面板（主页底栏「标签」弹出，分类筛选） -->
    <div class="tag-panel" id="tagPanel" hidden>
      {
        tags.map((t) => (
          <button
            type="button"
            class={`tag-opt${t === "全部" ? " tag-opt--active" : ""}`}
            data-tag={t}
            aria-pressed={t === "全部"}
          >
            {t}
          </button>
        ))
      }
    </div>

    <!-- 类型筛选面板（主页底栏「筛选」弹出：图文/图集/视频） -->
    <div class="tag-panel" id="typePanel" hidden>
      <button
        type="button"
        class="tag-opt tag-opt--active"
        data-type="全部"
        aria-pressed="true">全部</button
      >
      <button
        type="button"
        class="tag-opt"
        data-type="image"
        aria-pressed="false">图文</button
      >
      <button
        type="button"
        class="tag-opt"
        data-type="gallery"
        aria-pressed="false">图集</button
      >
      <button
        type="button"
        class="tag-opt"
        data-type="video"
        aria-pressed="false">视频</button
      >
    </div>

    <!-- 设置面板（布局切换） -->
    <div class="settings-panel" id="settingsPanel" hidden>
      <div class="settings-panel__header">
        <span class="settings-panel__title">显示设置</span>
        <button
          type="button"
          class="settings-panel__close"
          id="settingsClose"
          aria-label="关闭设置">×</button
        >
      </div>
      <div class="settings-group">
        <span class="settings-group__label">布局</span>
        <div class="layout-options">
          <button type="button" class="layout-opt" data-layout="masonry"
            >瀑布流</button
          >
          <button type="button" class="layout-opt" data-layout="list"
            >列表</button
          >
          <button type="button" class="layout-opt" data-layout="compact"
            >简洁</button
          >
        </div>
      </div>
      <div class="settings-group">
        <span class="settings-group__label">风格</span>
        <div class="layout-options">
          <button type="button" class="layout-opt" data-style="glass"
            >液态玻璃</button
          >
          <button type="button" class="layout-opt" data-style="flat"
            >扁平</button
          >
        </div>
        <div class="bg-dim-row" id="blurRow">
          <span class="bg-dim-row__label">玻璃模糊度</span>
          <input
            type="range"
            id="blurRange"
            min="0"
            max="30"
            step="1"
            aria-label="玻璃模糊度"
          />
        </div>
      </div>
      <div class="settings-group">
        <span class="settings-group__label">主题色</span>
        <div class="color-options">
          {
            site.theme.presets.map((c) => (
              <button
                type="button"
                class="color-opt"
                data-accent={c}
                style={`background:${c}`}
                aria-label={c}
                title={c}
              />
            ))
          }
        </div>
      </div>
      <div class="settings-group">
        <span class="settings-group__label">背景</span>
        <div class="layout-options">
          <button type="button" class="layout-opt" data-bg="on"
            >显示背景图</button
          >
          <button type="button" class="layout-opt" data-bg="off"
            >隐藏背景图</button
          >
        </div>
        <div class="bg-dim-row" id="bgDimGroup">
          <span class="bg-dim-row__label">背景图亮度</span>
          <input
            type="range"
            id="bgDimRange"
            min="0"
            max="100"
            step="5"
            aria-label="背景图亮度"
          />
        </div>
      </div>
      <div class="settings-group">
        <span class="settings-group__label">主页展示</span>
        <div class="layout-options">
          <button type="button" class="layout-opt" data-feed="paged"
            >分页</button
          >
          <button type="button" class="layout-opt" data-feed="infinite"
            >无限流</button
          >
        </div>
      </div>
      <div class="settings-group settings-group--slider">
        <span class="settings-group__label">正文字号</span>
        <input
          type="range"
          id="fontRange"
          min="14"
          max="22"
          step="1"
          aria-label="正文字号"
        />
      </div>
    </div>

    <!-- 分享卡片弹层（保存分享图 + 快速分享） -->
    <div class="share-modal" id="shareModal" hidden>
      <div class="share-modal__inner">
        <button
          type="button"
          class="share-modal__close"
          id="shareModalClose"
          aria-label="关闭">×</button
        >
        <img
          class="share-modal__img"
          id="shareImg"
          alt="分享卡片"
          decoding="async"
        />
        <div class="share-modal__actions">
          <button type="button" class="lg-btn" id="shareWechat">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
              ></path></svg
            >
            <span>分享</span>
          </button>
          <a
            class="lg-btn lg-btn--primary"
            id="shareDownload"
            href="#"
            download="share-card.png">保存图片</a
          >
        </div>
      </div>
    </div>

    <!-- 轻提示 toast -->
    <div class="toast" id="toast" role="status"></div>

    <!-- 图片灯箱（点击正文/封面图片放大，支持多图预览） -->
    <div class="lightbox" id="lightbox" hidden>
      <img class="lightbox__img" id="lightboxImg" alt="" decoding="async" />
      <button
        type="button"
        class="lightbox__close"
        id="lightboxClose"
        aria-label="关闭">×</button
      >
      <button
        type="button"
        class="lightbox__prev"
        id="lightboxPrev"
        aria-label="上一张">‹</button
      >
      <button
        type="button"
        class="lightbox__next"
        id="lightboxNext"
