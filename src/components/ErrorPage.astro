---
// 通用错误页模板：404 / 403 / 500 / 502 统一视觉
// 用法：<ErrorPage code="404" title="页面不存在" desc="..." />
interface Props {
  code: string;
  title: string;
  desc: string;
}
const { code, title, desc } = Astro.props;
---

<div class="nf-code">{code}</div>
<h1 class="nf-title">{title}</h1>
<p class="nf-desc">{desc}</p>
<a class="lg-btn lg-btn--primary nf-btn" href="/">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
  返回主页
</a>
